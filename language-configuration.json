{
    "comments": {
        // the macro language only has block comments (no line comment)
        "blockComment": [ "/*", "*/" ]
    },
    "brackets": [
        ["[", "]"],
        ["(", ")"]
    ],
    "autoClosingPairs": [
        ["[", "]"],
        ["(", ")"],
        { "open": "\"", "close": "\"", "notIn": ["string", "comment"] },
        { "open": "'", "close": "'", "notIn": ["string", "comment"] },
        { "open": "/*", "close": "*/", "notIn": ["string"] }
    ],
    "surroundingPairs": [
        ["[", "]"],
        ["(", ")"],
        ["\"", "\""],
        ["'", "'"],
        ["/*", "*/"]
    ],
    "colorizedBracketPairs": [
        ["(", ")"],
        ["[", "]"]
    ],
    "folding": {
        "markers": {
            "start": "^\\s*/\\*\\s*#?region\\b",
            "end": "^\\s*/\\*\\s*#?endregion\\b"
        }
    },
    "indentationRules": {
        // keywords are written either all upper case or all lower case; a block closed on the same line (IF ... END_IF) does not indent
        // the macro body stays at the same level as DEFINE, so DEFINE ... END_DEFINE is not listed here
        "increaseIndentPattern": "^\\s*(?:IF|if|SI|si|ELSE_IF|else_if|SINON_SI|sinon_si|ELSE|else|SINON|sinon|WHILE|while|TANT_QUE|tant_que|REPEAT|repeat|REPETER|repeter)\\b(?!.*\\b(?:END_IF|end_if|FIN_SI|fin_si|END_WHILE|end_while|FIN_TANT_QUE|fin_tant_que|UNTIL|until|JUSQU_A|jusqu_a)\\b).*$",
        "decreaseIndentPattern": "^\\s*(?:END_IF|end_if|FIN_SI|fin_si|ELSE_IF|else_if|SINON_SI|sinon_si|ELSE|else|SINON|sinon|END_WHILE|end_while|FIN_TANT_QUE|fin_tant_que|UNTIL|until|JUSQU_A|jusqu_a)\\b"
    },
    "wordPattern": "\\d+(?:\\.\\d+)?|[A-Za-z_\\u00C0-\\u00FF][A-Za-z0-9_\\u00C0-\\u00FF]*"
}
