{
  "name": "pros",
  "displayName": "PROS",
  "description": "PROS CPQ macro language support (Macro-Based BRC): syntax highlighting, snippets, indentation",
  "publisher": "NilsBzH",
  "version": "0.0.1",
  "license": "GPL-2.0-only",
  "keywords": [
    "pros",
    "cpq",
    "smart cpq",
    "macro",
    "brc",
    "pros connect"
  ],
  "engines": {
    "vscode": "^1.69.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "contributes": {
    "iconThemes": [
      {
        "id": "pros",
        "label": "pros icon theme",
        "path": "icons.json"
      }
    ],
    "languages": [
      {
        "id": "pros",
        "aliases": [
          "PROS macro language",
          "pros"
        ],
        "extensions": [
          ".pros"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "pros",
        "scopeName": "source.pros",
        "path": "./syntaxes/pros.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "pros",
        "path": "./snippets/pros.code-snippets"
      }
    ]
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/NilsBzH/pros.git"
  },
  "bugs": {
    "url": "https://github.com/NilsBzH/pros/issues"
  },
  "homepage": "https://github.com/NilsBzH/pros#readme",
  "devDependencies": {
    "vscode-tmgrammar-test": "^0.1.3"
  },
  "scripts": {
    "test:grammar": "vscode-tmgrammar-test \"test/grammar/*.test.pros\""
  }
}
