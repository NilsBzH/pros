{
  "name": "pros",
  "displayName": "PROS Macro Language (unofficial)",
  "description": "Unofficial support for the PROS Smart CPQ macro language (Macro-Based BRC): syntax highlighting, completion, hover, signature help, outline and diagnostics.",
  "publisher": "nilsbzh",
  "version": "0.1.0",
  "license": "GPL-2.0-only",
  "icon": "images/icon.png",
  "keywords": [
    "pros",
    "pros cpq",
    "smart cpq",
    "cpq",
    "macro",
    "macro language",
    "brc",
    "business rules",
    "pros connect"
  ],
  "engines": {
    "vscode": "^1.69.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "contributes": {
    "iconThemes": [
      {
        "id": "pros",
        "label": "pros icon theme",
        "path": "icons.json"
      }
    ],
    "languages": [
      {
        "id": "pros",
        "aliases": [
          "PROS macro language",
          "pros"
        ],
        "extensions": [
          ".pros"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "pros",
        "scopeName": "source.pros",
        "path": "./syntaxes/pros.tmLanguage.json"
      }
    ]
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/NilsBzH/pros.git"
  },
  "bugs": {
    "url": "https://github.com/NilsBzH/pros/issues"
  },
  "homepage": "https://github.com/NilsBzH/pros#readme",
  "devDependencies": {
    "@types/node": "^16.18.126",
    "@types/vscode": "1.69.0",
    "typescript": "^5.9.3",
    "vscode-tmgrammar-test": "^0.1.3"
  },
  "scripts": {
    "test:grammar": "vscode-tmgrammar-test \"test/grammar/*.test.pros\"",
    "compile": "tsc -p .",
    "watch": "tsc -watch -p .",
    "vscode:prepublish": "npm run compile",
    "test:unit": "npm run compile && node --test out/test/unit/",
    "test": "npm run test:unit && npm run test:grammar"
  },
  "main": "./out/src/extension.js",
  "activationEvents": [
    "onLanguage:pros"
  ]
}
