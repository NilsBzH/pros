{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "PROS macro language",
  "scopeName": "source.pros",
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#array-keys"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#macro-definition"
    },
    {
      "include": "#macro-end"
    },
    {
      "include": "#declarations"
    },
    {
      "include": "#confml"
    },
    {
      "include": "#java-classes"
    },
    {
      "include": "#predefined-objects"
    },
    {
      "include": "#environments"
    },
    {
      "include": "#builtin-functions"
    },
    {
      "include": "#table-functions"
    },
    {
      "include": "#constraint-operators"
    },
    {
      "include": "#control"
    },
    {
      "include": "#commands"
    },
    {
      "include": "#legacy-keywords"
    },
    {
      "include": "#constants"
    },
    {
      "include": "#numbers"
    },
    {
      "include": "#operators"
    },
    {
      "include": "#member-calls"
    },
    {
      "include": "#function-calls"
    },
    {
      "include": "#punctuation"
    }
  ],
  "repository": {
    "comments": {
      "name": "comment.block.pros",
      "begin": "/\\*",
      "end": "\\*/",
      "beginCaptures": {
        "0": {
          "name": "punctuation.definition.comment.begin.pros"
        }
      },
      "endCaptures": {
        "0": {
          "name": "punctuation.definition.comment.end.pros"
        }
      }
    },
    "array-keys": {
      "comment": "special array keys \"NR\", \"NF\", \"NC\", \"OP\" used as an index (reference § 7)",
      "match": "(?<=[\\[,])\\s*(([\"'])(?:NR|NF|NC|OP)\\2)(?=\\s*[\\],])",
      "captures": {
        "1": {
          "name": "constant.other.array-key.pros"
        }
      }
    },
    "strings": {
      "comment": "quotes are escaped by doubling them; backslash is a literal character (reference § 2.3)",
      "patterns": [
        {
          "name": "string.quoted.double.pros",
          "begin": "\"",
          "end": "\"(?!\")",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.string.begin.pros"
            }
          },
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.string.end.pros"
            }
          },
          "patterns": [
            {
              "match": "\"\"",
              "name": "constant.character.escape.pros"
            }
          ]
        },
        {
          "name": "string.quoted.single.pros",
          "begin": "'",
          "end": "'(?!')",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.string.begin.pros"
            }
          },
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.string.end.pros"
            }
          },
          "patterns": [
            {
              "match": "''",
              "name": "constant.character.escape.pros"
            }
          ]
        }
      ]
    },
    "macro-definition": {
      "name": "meta.function.definition.pros",
      "begin": "\\b(definition|DEFINITION|define|DEFINE)\\s+([A-Za-z_\\x{00C0}-\\x{00FF}][A-Za-z0-9_\\x{00C0}-\\x{00FF}]*)\\s*(\\()",
      "end": "\\)",
      "beginCaptures": {
        "1": {
          "name": "keyword.control.define.pros"
        },
        "2": {
          "name": "entity.name.function.pros"
        },
        "3": {
          "name": "punctuation.definition.parameters.begin.pros"
        }
      },
      "endCaptures": {
        "0": {
          "name": "punctuation.definition.parameters.end.pros"
        }
      },
      "patterns": [
        {
          "include": "#comments"
        },
        {
          "match": "[A-Za-z_\\x{00C0}-\\x{00FF}][A-Za-z0-9_\\x{00C0}-\\x{00FF}]*",
          "name": "variable.parameter.pros"
        },
        {
          "match": ",",
          "name": "punctuation.separator.parameter.pros"
        }
      ]
    },
    "macro-end": {
      "match": "\\b(?:end_definition|END_DEFINITION|fin_definition|FIN_DEFINITION|definition|DEFINITION|end_define|END_DEFINE|define|DEFINE)\\b",
      "name": "keyword.control.define.pros"
    },
    "declarations": {
      "match": "\\b(local|LOCAL|soit|SOIT|let|LET)\\b(?:\\s+([A-Za-z_\\x{00C0}-\\x{00FF}][A-Za-z0-9_\\x{00C0}-\\x{00FF}]*(?:\\.[A-Za-z_\\x{00C0}-\\x{00FF}][A-Za-z0-9_\\x{00C0}-\\x{00FF}]*)*))?",
      "captures": {
        "1": {
          "name": "storage.type.pros"
        },
        "2": {
          "name": "variable.other.pros"
        }
      }
    },
    "confml": {
      "comment": "confML configuration object (reference § 5.17)",
      "match": "\\b(confML)\\b(?:\\s*(\\.)\\s*(clearBusinessExplanations|getDefaultPricingMethods|raiseBusinessExplanation|getExistingObjectByCPE|saveConfiguration|getPricesOfItems|getBdtTableName|setSimpleOutput|getObjectByCPE|getSimpleInput|isObjectLoaded|isDomainValue|raiseSetValue|setListOutput|getListInput|getSettings|raiseAction|setSettings|getSetting|setSetting)\\b)?",
      "captures": {
        "1": {
          "name": "support.variable.pros"
        },
        "2": {
          "name": "punctuation.accessor.pros"
        },
        "3": {
          "name": "support.function.confml.pros"
        }
      }
    },
    "java-classes": {
      "comment": "short closed list of Java classes seen in the manual or in real files",
      "match": "\\b(?:LinkedHashMap|MLRestClient|ObjectMapper|Integer|Double|String|Long)\\b(?=\\s*[(.])",
      "name": "support.class.java.pros"
    },
    "predefined-objects": {
      "match": "\\b(?:ACMailMessage|ACDate|ACMail)\\b",
      "name": "support.class.pros"
    },
    "environments": {
      "comment": "environment addressing (reference § 4.3); racine is also a SQRT synonym, so it is an environment only before a dot",
      "patterns": [
        {
          "match": "\\b(?:root|current|super)\\b",
          "name": "variable.language.pros"
        },
        {
          "match": "\\bracine\\b(?=\\s*\\.)",
          "name": "variable.language.pros"
        }
      ]
    },
    "builtin-functions": {
      "match": "\\b(?:SqlCloseCreatedPools|remplacer_chaine|REMPLACER_CHAINE|chercher_chaine|CHERCHER_CHAINE|SqlConnectPool2|trouver_chaine|TROUVER_CHAINE|DecimalRound|SqlReadTable|DaysBetween|IsConnected|replace_str|REPLACE_STR|sous_chaine|SOUS_CHAINE|StringFnawk|IsDefined|IsInArray|majuscule|MAJUSCULE|minuscule|MINUSCULE|oteblancs|OTEBLANCS|find_str|FIND_STR|IsNumber|IsObject|IsString|longueur|LONGUEUR|IsArray|IsEqual|version|VERSION|chaine|CHAINE|length|LENGTH|nombre|NOMBRE|number|NUMBER|racine|RACINE|substr|SUBSTR|atan2|ATAN2|carre|CARRE|fract|FRACT|heure|HEURE|lower|LOWER|upper|UPPER|acos|ACOS|aifn|AIFN|asin|ASIN|atan|ATAN|date|DATE|Lpad|Rpad|sqrt|SQRT|time|TIME|trim|TRIM|abs|ABS|Chr|cos|COS|ent|ENT|exp|EXP|int|INT|log|LOG|rpt|RPT|sin|SIN|sqr|SQR|str|STR|tan|TAN|ln|LN)\\b",
      "name": "support.function.pros"
    },
    "table-functions": {
      "match": "\\b(?:notContains|sum_prod_if|concat_if|notInside|contains|sum_prod|between|prod_if|avg_if|concat|inside|max_if|min_if|sum_if|copy|prod|avg|geq|leq|max|min|neq|sum|eq|gt|lt)\\b(?=\\s*\\()",
      "name": "support.function.table.pros"
    },
    "constraint-operators": {
      "match": "\\b(?:opNotBetweenStrict|opNotInsideByName|opBetweenStrict|opInsideByName|opNotBetween|opNotInside|opBetween|opNotLike|opInside|opLike|opGeq|opLeq|opNeq|opEq|opGt|opLt)\\b",
      "name": "support.function.operator.pros"
    },
    "control": {
      "match": "\\b(?:sortie_boucle|SORTIE_BOUCLE|fin_tant_que|FIN_TANT_QUE|sortie_macro|SORTIE_MACRO|exit_macro|EXIT_MACRO|end_while|END_WHILE|exit_loop|EXIT_LOOP|sinon_si|SINON_SI|tant_que|TANT_QUE|else_if|ELSE_IF|jusqu_a|JUSQU_A|repeter|REPETER|end_if|END_IF|fin_si|FIN_SI|repeat|REPEAT|sinon|SINON|until|UNTIL|while|WHILE|else|ELSE|if|IF|si|SI)\\b",
      "name": "keyword.control.pros"
    },
    "commands": {
      "match": "\\b(?:supprimer_environnement|SUPPRIMER_ENVIRONNEMENT|changer_environnement|CHANGER_ENVIRONNEMENT|creer_environnement|CREER_ENVIRONNEMENT|créer_environnement|change_environment|CHANGE_ENVIRONMENT|create_environment|CREATE_ENVIRONMENT|delete_environment|DELETE_ENVIRONMENT|supprimer_macro|SUPPRIMER_MACRO|environnement|ENVIRONNEMENT|supprimer_var|SUPPRIMER_VAR|delete_macro|DELETE_MACRO|environment|ENVIRONMENT|concat_anc|CONCAT_ANC|delete_var|DELETE_VAR|sql_query|SQL_QUERY|supprimer|SUPPRIMER|trace_fin|TRACE_FIN|trace_off|TRACE_OFF|afficher|AFFICHER|supp_anc|SUPP_ANC|variable|VARIABLE|del_old|DEL_OLD|display|DISPLAY|message|MESSAGE|append|APPEND|delete|DELETE|detail|DETAIL|droite|DROITE|erreur|ERREUR|gauche|GAUCHE|lister|LISTER|error|ERROR|macro|MACRO|right|RIGHT|selon|SELON|trace|TRACE|using|USING|avec|AVEC|dans|DANS|left|LEFT|list|LIST|name|NAME|tout|TOUT|with|WITH|all|ALL|nom|NOM|in|IN)\\b",
      "name": "keyword.other.pros"
    },
    "legacy-keywords": {
      "comment": "words of the original grammar not found in the documentation, kept on user request",
      "match": "\\b(?:sql_connect|SQL_CONNECT|lire_table|LIRE_TABLE|read_table|READ_TABLE|arrondi|ARRONDI|memoire|MEMOIRE|ou_excl|OU_EXCL|systeme|SYSTEME|memory|MEMORY|force|FORCE|beep|BEEP|exor|EXOR|mod|MOD)\\b",
      "name": "keyword.other.pros"
    },
    "constants": {
      "match": "\\b(?:false|FALSE|faux|FAUX|true|TRUE|vrai|VRAI|pi|PI|e|E)\\b",
      "name": "constant.language.pros"
    },
    "numbers": {
      "comment": "integers and decimals with a dot only (Q-05)",
      "match": "\\b\\d+(?:\\.\\d+)?\\b",
      "name": "constant.numeric.pros"
    },
    "operators": {
      "patterns": [
        {
          "match": ":=",
          "name": "keyword.operator.assignment.pros"
        },
        {
          "match": "<>|<=|>=|=|<|>",
          "name": "keyword.operator.comparison.pros"
        },
        {
          "match": "\\*\\*|\\^|[-+*/%]",
          "name": "keyword.operator.arithmetic.pros"
        },
        {
          "match": "\\b(?:puissance|PUISSANCE|modulo|MODULO|power|POWER|reste|RESTE|div|DIV)\\b",
          "name": "keyword.operator.arithmetic.pros"
        },
        {
          "match": "\\b(?:ex_or|EX_OR|and|AND|not|NOT|et|ET|or|OR|ou|OU)\\b",
          "name": "keyword.operator.logical.pros"
        }
      ]
    },
    "member-calls": {
      "comment": "object or Java method call: obj.method(",
      "match": "(\\.)\\s*([A-Za-z_\\x{00C0}-\\x{00FF}][A-Za-z0-9_\\x{00C0}-\\x{00FF}]*)(?=\\s*\\()",
      "captures": {
        "1": {
          "name": "punctuation.accessor.pros"
        },
        "2": {
          "name": "entity.name.function.member.pros"
        }
      }
    },
    "function-calls": {
      "comment": "any other call: user macro, external static method, constructor",
      "match": "\\b([A-Za-z_\\x{00C0}-\\x{00FF}][A-Za-z0-9_\\x{00C0}-\\x{00FF}]*)(?=\\s*\\()",
      "captures": {
        "1": {
          "name": "entity.name.function.pros"
        }
      }
    },
    "punctuation": {
      "patterns": [
        {
          "match": ",",
          "name": "punctuation.separator.comma.pros"
        },
        {
          "match": "[()]",
          "name": "meta.brace.round.pros"
        },
        {
          "match": "[\\[\\]]",
          "name": "meta.brace.square.pros"
        }
      ]
    }
  }
}
